<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="1083.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre8.controller.UsuariosController">

    <children>

        <Label layoutX="350.0" layoutY="15.0" text="Gestión de Usuarios">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Campos del Formulario -->

        <Label layoutX="30.0" layoutY="60.0" text="Usuario:" />
        <TextField fx:id="txtId" layoutX="110.0" layoutY="55.0" prefWidth="180.0" promptText="Username" />

        <Label layoutX="30.0" layoutY="100.0" text="Contraseña:" />
        <TextField fx:id="txtNombre" layoutX="110.0" layoutY="95.0" prefWidth="180.0" promptText="##########" />

        <Label layoutX="30.0" layoutY="140.0" text="Confirmar:" />
        <TextField fx:id="txtApellido" layoutX="110.0" layoutY="135.0" prefWidth="180.0" promptText="#######" />

        <Label layoutX="30.0" layoutY="180.0" text="Rol:" />
        <TextField fx:id="txtUsername" layoutX="110.0" layoutY="175.0" prefWidth="180.0" promptText="Ej. Cajero" />

        <Label layoutX="30.0" layoutY="220.0" text="Nombre:" />
        <TextField fx:id="txtCorreo" layoutX="110.0" layoutY="215.0" prefWidth="180.0" promptText="Nombre" />

        <Label layoutX="30.0" layoutY="260.0" text="Apellido:" />
        <TextField fx:id="txtRol" layoutX="110.0" layoutY="255.0" prefWidth="180.0" promptText="Apellido" />

        <Label layoutX="30.0" layoutY="300.0" text="Correo:" />
        <TextField fx:id="txtRol1" layoutX="110.0" layoutY="295.0" prefWidth="180.0" promptText="Ej. Raf12@gmail.com" />

        <!-- COMBOBOX DE ESTADO (Activo / Inactivo) -->
        <Label layoutX="30.0" layoutY="340.0" text="Estado:" />
        <ComboBox fx:id="cmbEstado" layoutX="110.0" layoutY="335.0" prefWidth="180.0" promptText="Seleccionar Estado" />

        <!-- Botones -->

        <Button layoutX="16.0" layoutY="390.0" mnemonicParsing="false" onAction="#guardarUsuario" prefHeight="35.0" prefWidth="120.0" text="Guardar" />

        <Button layoutX="157.0" layoutY="390.0" mnemonicParsing="false" onAction="#modificarUsuario" prefHeight="35.0" prefWidth="120.0" text="Modificar" />

        <Button layoutX="16.0" layoutY="438.0" mnemonicParsing="false" onAction="#eliminarUsuario" prefHeight="35.0" prefWidth="120.0" text="Eliminar" />

        <Button layoutX="157.0" layoutY="438.0" mnemonicParsing="false" onAction="#limpiarCampos" prefHeight="35.0" prefWidth="120.0" text="Limpiar" />

        <!-- Tabla de Usuarios -->

        <TableView fx:id="tblUsuarios" editable="true" layoutX="320.0" layoutY="55.0" prefHeight="410.0" prefWidth="700.0">

            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="110.0" text="Nombre" />
                <TableColumn fx:id="colApellido" prefWidth="110.0" text="Apellido" />
                <TableColumn fx:id="colUsuario" prefWidth="110.0" text="Usuario" />
                <TableColumn fx:id="colCorreo" prefWidth="140.0" text="Correo" />
                <TableColumn fx:id="colRol1" prefWidth="90.0" text="Rol" />
                <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
            </columns>

        </TableView>

    </children>

</Pane>
