<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="org.paginalibre8.controller.BuscadorLibrosController"
            stylesheets="@menuprincipaldashboardview.css"
            prefWidth="920.0" prefHeight="640.0">
    <top>
        <VBox alignment="CENTER" spacing="8" styleClass="header-box">
            <padding><Insets top="20" right="25" bottom="15" left="25"/></padding>
            <Label text="Buscador de Libros" styleClass="title-label" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Consulta el catálogo de libros por ISBN, Título o Autor" styleClass="subtitulo"/>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="15">
            <padding><Insets top="15" right="25" bottom="20" left="25"/></padding>
            
            <!-- Panel de Formulario de Búsqueda (T2.6) -->
            <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;">
                <Label text="Filtros de Búsqueda:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <GridPane hgap="12" vgap="10">
                    <Label text="Buscar por ISBN:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <TextField fx:id="txtBuscarIsbn" promptText="Ej: 978-3-16-148410-0" prefWidth="250"/>
                        <Button fx:id="btnBuscarIsbn" text="Buscar ISBN" onAction="#handleBuscarPorIsbn" styleClass="menu-button" style="-fx-padding: 6 12;"/>
                    </HBox>
                    
                    <Label text="Buscar por Título:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <TextField fx:id="txtBuscarTitulo" promptText="Título o palabra clave..." prefWidth="250"/>
                        <Button fx:id="btnBuscarTitulo" text="Buscar Título" onAction="#handleBuscarPorTitulo" styleClass="menu-button" style="-fx-padding: 6 12;"/>
                    </HBox>
                    
                    <Label text="Buscar por Autor:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="2" GridPane.columnIndex="1">
                        <TextField fx:id="txtBuscarAutor" promptText="Nombre del autor..." prefWidth="250"/>
                        <Button fx:id="btnBuscarAutor" text="Buscar Autor" onAction="#handleBuscarPorAutor" styleClass="menu-button" style="-fx-padding: 6 12;"/>
                    </HBox>
                </GridPane>
                
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
                    <Button fx:id="btnListarTodos" text="Mostrar Todos" onAction="#handleListarTodos" styleClass="menu-button" style="-fx-background-color: #2b579a; -fx-text-fill: white;"/>
                    <Button fx:id="btnLimpiar" text="Limpiar Filtros" onAction="#handleLimpiar" styleClass="exit-button" style="-fx-padding: 6 15;"/>
                    <Label fx:id="lblEstado" text="" style="-fx-font-style: italic; -fx-text-fill: #555555;"/>
                </HBox>
            </VBox>
            
            <!-- Tabla de Resultados de Libros (T2.7) -->
            <VBox VBox.vgrow="ALWAYS" spacing="5">
                <Label text="Resultados del Catálogo:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <TableView fx:id="tblLibros" VBox.vgrow="ALWAYS" prefHeight="320">
                    <columns>
                        <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="130"/>
                        <TableColumn fx:id="colTitulo" text="Título" prefWidth="240"/>
                        <TableColumn fx:id="colAutor" text="Autor" prefWidth="160"/>
                        <TableColumn fx:id="colPrecio" text="Precio (Q)" prefWidth="90"/>
                        <TableColumn fx:id="colStock" text="Stock" prefWidth="70"/>
                        <TableColumn fx:id="colFecha" text="Publicación" prefWidth="100"/>
                        <TableColumn fx:id="colEditorial" text="Editorial" prefWidth="110"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
