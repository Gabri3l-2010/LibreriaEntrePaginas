<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="920.0" stylesheets="@menuprincipaldashboardview.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.paginalibre8.controller.RegistrarIngresoInventarioController">
    <top>
        <VBox alignment="CENTER_LEFT" spacing="5" styleClass="header-box">
            <padding><Insets top="20" right="25" bottom="15" left="25"/></padding>
            <Label text="Registrar ingreso de inventario" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="El stock se actualiza únicamente al registrar este movimiento."/>
        </VBox>
    </top>
    <center>
        <VBox spacing="18" style="-fx-padding: 30;">
            <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-padding: 22; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;">
                <Label text="Datos del ingreso" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <GridPane hgap="15" vgap="15">
                    <Label text="Libro:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="cmbLibro" promptText="Selecciona un libro" prefWidth="450" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label fx:id="lblStockActual" text="Stock actual: —" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Cantidad:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtCantidad" promptText="Ej. 10" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Observación:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextArea fx:id="txtObservacion" promptText="Opcional" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
                <HBox spacing="10">
                    <Button text="Registrar ingreso" onAction="#handleRegistrarIngreso" styleClass="menu-button"/>
                    <Button text="Limpiar" onAction="#handleLimpiar" styleClass="exit-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
