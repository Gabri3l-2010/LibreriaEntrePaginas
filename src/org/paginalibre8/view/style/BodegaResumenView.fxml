<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<BorderPane prefHeight="640.0" prefWidth="920.0" stylesheets="@menuprincipaldashboardview.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.paginalibre8.controller.BodegaResumenController">
    <top>
        <VBox alignment="CENTER_LEFT" spacing="5" styleClass="header-box">
            <padding><Insets top="20" right="25" bottom="15" left="25"/></padding>
            <Label text="Resumen de Inventario" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Monitorea los libros que requieren tu atención inmediata."/>
        </VBox>
    </top>
    <center>
        <VBox spacing="20" style="-fx-padding: 25;">
            
            <!-- Tarjeta de alerta de stock crítico -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #fee2e2; -fx-padding: 15 20; -fx-background-radius: 8; -fx-border-color: #fca5a5; -fx-border-radius: 8;">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Alerta de Stock Crítico" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #991b1b;"/>
                    <Label text="Los siguientes libros tienen un nivel de stock igual o inferior al mínimo configurado." style="-fx-text-fill: #7f1d1d;"/>
                </VBox>
                <VBox alignment="CENTER" style="-fx-background-color: #ef4444; -fx-padding: 10 20; -fx-background-radius: 6;">
                    <Label fx:id="lblContadorCritico" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Libros Críticos" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>
            </HBox>
            
            <VBox VBox.vgrow="ALWAYS" spacing="10">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Listado de libros en estado crítico" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                </HBox>
                
                <TableView fx:id="tblStockCritico" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="130"/>
                        <TableColumn fx:id="colTitulo" text="Título del Libro" prefWidth="350"/>
                        <TableColumn fx:id="colStockActual" text="Stock Actual" prefWidth="120" style="-fx-alignment: CENTER; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                        <TableColumn fx:id="colStockMinimo" text="Stock Mínimo" prefWidth="120" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colAccion" text="Acción" prefWidth="120" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
            
        </VBox>
    </center>
</BorderPane>
