<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre8.controller.RegistrarUsuarioController">
    <stylesheets>
        <URL value="@/org/paginalibre8/view/style/registrarusuarioview.css" />
    </stylesheets>
    <children>
        <StackPane layoutX="93.0" layoutY="78.0" prefHeight="245.0" prefWidth="415.0">
            <children>
                <GridPane>
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="99.0" minWidth="10.0" prefWidth="46.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="162.0" minWidth="10.0" prefWidth="128.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="211.0" minWidth="10.0" prefWidth="190.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="97.0" minWidth="10.0" prefWidth="50.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Usuario" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Contraseña" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Confirmar Contraseña" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <TextField fx:id="txtUsusario" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <PasswordField fx:id="txtPassword" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <PasswordField fx:id="txtConfirmarPassword" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                    </children>
                </GridPane>
            </children>
        </StackPane>
        <Button fx:id="btnRegresar" layoutX="22.0" layoutY="21.0" mnemonicParsing="false" onAction="#eventoRegresar" prefHeight="25.0" prefWidth="94.0" text="REGRESAR" />
        <Button fx:id="btnRegistrar" layoutX="239.0" layoutY="347.0" mnemonicParsing="false" onAction="#eventoRegistrar" prefHeight="25.0" prefWidth="145.0" text="REGISTRAR" />
        <Label layoutX="155.0" layoutY="46.0" text="REGISTRAR NUEVO USUARIO">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <Label fx:id="lblMensaje" layoutX="239.0" layoutY="323.0" text="mensaje" />
    </children>
