<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="mainFxmlClass" 
            stylesheets="@menuprincipaldashboardview.css" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="org.paginalibre8.controller.DashboardCajeroController"
            prefWidth="1000.0" prefHeight="720.0">
    <top>
        <VBox alignment="CENTER" spacing="6" styleClass="header-box">
            <padding><Insets top="20" right="25" bottom="15" left="25"/></padding>
            <Label styleClass="title-label" text="Librería Entre Páginas - Panel de Cajero" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label fx:id="lblUsuario" text="Cajero" styleClass="subtitulo"/>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="15">
            <padding><Insets top="15" right="25" bottom="20" left="25"/></padding>
            
            <!-- Resumen de Tarjetas (KPIs) del Día (T2.28 - T2.29) -->
            <HBox spacing="20" alignment="CENTER">
                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #ffffff; -fx-padding: 15 30; -fx-background-radius: 8; -fx-border-color: #dcdcdc; -fx-border-radius: 8;" prefWidth="280">
                    <Label text="Total Vendido Hoy" style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>
                    <Label fx:id="lblTotalVentasDia" text="Q 0.00" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2b579a;"/>
                </VBox>
                
                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #ffffff; -fx-padding: 15 30; -fx-background-radius: 8; -fx-border-color: #dcdcdc; -fx-border-radius: 8;" prefWidth="280">
                    <Label text="Ventas Realizadas Hoy" style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>
                    <Label fx:id="lblCantVentasDia" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2b579a;"/>
                </VBox>
            </HBox>
            
            <!-- Nueva Venta embebida directamente en el panel -->
            <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;">
                <Label text="Nueva Venta:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <GridPane hgap="12" vgap="10">
                    <Label text="Cliente:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <TextField fx:id="txtNitCliente" promptText="NIT o C/F" prefWidth="180"/>
                        <TextField fx:id="txtNombreCliente" promptText="Nombre del cliente" prefWidth="250"/>
                    </HBox>
                    
                    <Label text="Libro (ISBN):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <TextField fx:id="txtIsbn" promptText="Ingrese ISBN del libro" prefWidth="180"/>
                        <Label text="Cantidad:"/>
                        <Spinner fx:id="spnCantidad" prefWidth="90" editable="true"/>
                        <Button fx:id="btnAgregar" text="Agregar al Carrito" onAction="#handleAgregarProducto" styleClass="menu-button" style="-fx-padding: 6 12;"/>
                    </HBox>
                </GridPane>
                
                <!-- Carrito de Venta -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Carrito de Venta:" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <Button fx:id="btnEliminarDetalle" text="Quitar Seleccionado" onAction="#handleEliminarProducto" styleClass="exit-button" style="-fx-padding: 4 10;"/>
                    <Button fx:id="btnVaciar" text="Vaciar Carrito" onAction="#handleVaciarCarrito" styleClass="exit-button" style="-fx-padding: 4 10;"/>
                </HBox>
                
                <TableView fx:id="tblCarrito" prefHeight="180">
                    <columns>
                        <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="140"/>
                        <TableColumn fx:id="colTitulo" text="Título del Libro" prefWidth="280"/>
                        <TableColumn fx:id="colPrecio" text="Precio Unit. (Q)" prefWidth="110"/>
                        <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="100"/>
                        <TableColumn fx:id="colSubtotal" text="Subtotal (Q)" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                
                <!-- Resumen de Totales -->
                <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-background-color: #eef2f7; -fx-padding: 12; -fx-background-radius: 6;">
                    <Label text="Total a Pagar:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTotal" text="Q 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2b579a;"/>
                    <Button fx:id="btnProcesarVenta" text="Registrar Venta" onAction="#handleProcesarVenta" styleClass="menu-button"/>
                </HBox>
            </VBox>
            
            <!-- Acciones de Menú -->
            <HBox spacing="12" alignment="CENTER">
                <Button fx:id="btnClientes" onAction="#handleClientes" prefHeight="38" prefWidth="180" styleClass="menu-button" text="Consultar Clientes" />
                <Button fx:id="btnCambiarPassword" onAction="#handleCambiarPassword" prefHeight="38" prefWidth="180" styleClass="menu-button" text="Cambiar Contraseña" />
                <Button fx:id="btnSalir" onAction="#handleSalir" prefHeight="38" prefWidth="180" styleClass="exit-button" text="Cerrar Sesión" />
            </HBox>
            
            <!-- Tabla de Resumen de Ventas del Día (T2.29) -->
            <VBox VBox.vgrow="ALWAYS" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Registro de Ventas del Día:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Button fx:id="btnRefrescar" text="Refrescar" onAction="#handleRefrescarVentas" styleClass="menu-button" style="-fx-padding: 4 12;"/>
                </HBox>
                
                <TableView fx:id="tblVentasDia" VBox.vgrow="ALWAYS" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colIdVenta" text="N° Venta" prefWidth="100"/>
                        <TableColumn fx:id="colFechaVenta" text="Fecha / Hora" prefWidth="200"/>
                        <TableColumn fx:id="colNitCliente" text="NIT Cliente" prefWidth="140"/>
                        <TableColumn fx:id="colTotalVenta" text="Total (Q)" prefWidth="140"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>