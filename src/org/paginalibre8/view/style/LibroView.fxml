<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalibre8.controller.LibroController" styleClass="libro-root" stylesheets="@libroview.css">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10" styleClass="form-container">
            <padding><Insets right="20" /></padding>
            <Label styleClass="section-title" text="Registrar Libro" />
            <TextField fx:id="txtIsbn" promptText="ISBN" styleClass="form-text" />
            <TextField fx:id="txtTitulo" promptText="Título" styleClass="form-text" />
            <TextField fx:id="txtFechaPublicacion" promptText="Fecha Publicación (AAAA-MM-DD)" styleClass="form-text" />
            <TextField fx:id="txtPrecio" promptText="Precio" styleClass="form-text" />
            <TextField fx:id="txtIdCategoria" promptText="ID Categoría" styleClass="form-text" />
            <TextField fx:id="txtNitEditorial" promptText="NIT Editorial" styleClass="form-text" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" styleClass="primary-button" />
                <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" styleClass="primary-button" />
            </HBox>
            <Label fx:id="lblMensaje" styleClass="message-label" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label styleClass="section-title" text="Lista de Libros" />
            <TableView fx:id="tablaLibros" styleClass="libro-table">
                <columns>
                    <TableColumn fx:id="colIsbn" prefWidth="100" text="ISBN" />
                    <TableColumn fx:id="colTitulo" prefWidth="140" text="Título" />
                    <TableColumn fx:id="colFechaPublicacion" prefWidth="120" text="Publicación" />
                    <TableColumn fx:id="colPrecio" prefWidth="80" text="Precio" />
                    <TableColumn fx:id="colIdCategoria" prefWidth="90" text="Categoría" />
                    <TableColumn fx:id="colNitEditorial" prefWidth="110" text="NIT Editorial" />
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#handleActualizar" text="Actualizar Tabla" styleClass="table-button" />
                <Button onAction="#handleVolver" text="Volver al Menú" styleClass="table-button" />
            </HBox>
        </VBox>
    </center>
</BorderPane>