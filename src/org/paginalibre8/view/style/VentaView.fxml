<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="org.paginalibre8.controller.VentaController"
            stylesheets="@menuprincipaldashboardview.css"
            prefWidth="940.0" prefHeight="660.0">
    <top>
        <VBox alignment="CENTER" spacing="6" styleClass="header-box">
            <padding><Insets top="20" right="25" bottom="15" left="25"/></padding>
            <Label text="Punto de Venta" styleClass="title-label" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="15">
            <padding><Insets top="15" right="25" bottom="20" left="25"/></padding>
            
            <!-- Datos del Cliente y Agregar Producto -->
            <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8;">
                <GridPane hgap="12" vgap="10">
                    <Label text="NIT Cliente:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <TextField fx:id="txtNitCliente" promptText="NIT o C/F" prefWidth="180"/>
                        <TextField fx:id="txtNombreCliente" promptText="Nombre del cliente" prefWidth="250"/>
                    </HBox>
                    
                    <Label text="Libro (ISBN):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <TextField fx:id="txtIsbn" promptText="Ingrese ISBN del libro" prefWidth="180"/>
                        <Label text="Cantidad:"/>
                        <Spinner fx:id="spnCantidad" prefWidth="90" editable="true"/>
                        <Button fx:id="btnAgregar" text="Agregar al Carrito" onAction="#handleAgregarProducto" styleClass="menu-button" style="-fx-padding: 6 12;"/>
                    </HBox>
                </GridPane>
            </VBox>
            
            <!-- Carrito de Compras (T2.12 - T2.16) -->
            <VBox VBox.vgrow="ALWAYS" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Carrito de Venta:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Button fx:id="btnEliminarDetalle" text="Quitar Seleccionado" onAction="#handleEliminarProducto" styleClass="exit-button" style="-fx-padding: 4 10;"/>
                    <Button fx:id="btnVaciar" text="Vaciar Carrito" onAction="#handleVaciarCarrito" styleClass="exit-button" style="-fx-padding: 4 10;"/>
                </HBox>
                
                <TableView fx:id="tblCarrito" VBox.vgrow="ALWAYS" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="140"/>
                        <TableColumn fx:id="colTitulo" text="Título del Libro" prefWidth="280"/>
                        <TableColumn fx:id="colPrecio" text="Precio Unit. (Q)" prefWidth="110"/>
                        <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="100"/>
                        <TableColumn fx:id="colSubtotal" text="Subtotal (Q)" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                
                <!-- Resumen de Totales -->
                <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-background-color: #eef2f7; -fx-padding: 12; -fx-background-radius: 6;">
                    <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <Label text="Total vendido hoy:" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
                        <Label fx:id="lblTotalHoy" text="Q 0.00" style="-fx-font-size: 15px; -fx-text-fill: #27ae60; -fx-font-weight: bold;" />
                    </VBox>
                    <Label text="Total a Pagar:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTotal" text="Q 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2b579a;"/>
                    <Button fx:id="btnProcesarVenta" text="Registrar Venta" onAction="#handleProcesarVenta" styleClass="menu-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
